# OpenAI API configuration
# Get your API key from: https://platform.openai.com/account/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Jira configuration
# Base URL for your Jira instance
JIRA_BASE=https://your-domain.atlassian.net
# Base64 encoded "username:api_token" for Jira authentication
# Generate at: https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_BASIC=base64_encoded_user_colon_apitoken

# MCP server configuration
# Port for the MCP (Model Context Protocol) server
MCP_PORT=3333

# Optional: Set to 'true' for dry-run mode (no actual OmniFocus changes)
# This is useful for testing without making real changes
DRY_RUN=false

# Optional: Override default OpenAI models
# OPENAI_MODEL=gpt-4o
# OPENAI_MODEL_MINI=gpt-4o-mini

# Optional: Override default MCP port
# MCP_PORT=3333 